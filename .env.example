# OM Logistics Intelligent Control Tower — environment template.
# Copy to .env.local for local overrides. Never commit real values.
# Every variable is optional for the Phase 1 demo; defaults are shown.

NODE_ENV=development

# --- Demo / simulation --------------------------------------------------------
DEMO_MODE=true
SIMULATION_ENABLED=true
# Allowed: 1, 5, 20 (other values snap to the nearest).
SIMULATION_SPEED=5

# --- Data ---------------------------------------------------------------------
# Not required in DEMO_MODE (in-memory repositories). Used by Prisma migrate/seed
# and future PostgreSQL repositories, e.g. postgresql://user:pass@localhost:5432/om_ct
DATABASE_URL=

# Signs opaque public tracking tokens. Required outside DEMO_MODE.
AUTH_SECRET=

# --- Map ----------------------------------------------------------------------
# demo  = OpenFreeMap (keyless) · carto = CARTO basemaps (keyless)
MAP_PROVIDER=demo
MAP_API_KEY=

# --- Notifications ------------------------------------------------------------
# Phase 1 supports only the in-app demo provider (Sonner + notification center).
NOTIFICATION_PROVIDER_MODE=in_app_demo

# --- App ----------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# sse | polling
REALTIME_TRANSPORT=sse

# --- Business-rule thresholds (optional overrides) ------------------------------
# STALE_GPS_MINUTES=20
# NO_MOVEMENT_MINUTES=30
# HUB_DWELL_WARNING_MINUTES=45
# HUB_DWELL_CRITICAL_MINUTES=90
# ROUTE_DEVIATION_METERS=1000
# ETA_NOTIFICATION_DELTA_MINUTES=30

# --- FUTURE ONLY — documented, not used, not required ---------------------------
# External messaging providers are NOT implemented in Phase 1.
# WHATSAPP_API_KEY=
# SMS_API_KEY=
# EMAIL_API_KEY=
